.DS_Store
goodhr4/frontend/node_modules/
goodhr4/site/node_modules/
goodhr4/**/.next/
goodhrpy/.venv/
**/.venv/
**/cookies/
**/logs/**
# 后台日志页面属于前端源码，不能按运行日志忽略。
!/goodhr5/cloud/frontend-next/app/admin/logs/
!/goodhr5/cloud/frontend-next/app/admin/logs/**
goodhr5/cloud/backend/logs/backend.log
goodhr5/local-agent/logs/agent.log
goodhr5/local-agent/vendor/cloakbrowser/
goodhr5/local-agent/vendor/downloads/
goodhr5/local-agent/build/
goodhr5/local-agent/dist/
.trae/**
**/.codex-run/**
goodhr5/scripts/__pycache__/
/goodhr5/.release-source.lock
**/dist-installer/**
# 微信支付证书只能保存在部署机，禁止提交到 Git。
**/certs/wechat/*.pem
**/secrets/wechat/*.pem

# 私有部署的密码与持久业务文件不能进入仓库。
goodhr5/environments/private.env
goodhr5/private-data/
goodhr5/browser-extension/dist-private/

# 浏览器检查记录和截图属于本机验收产物。
/.playwright-cli/
/output/playwright/
