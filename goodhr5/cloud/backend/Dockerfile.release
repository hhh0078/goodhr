# 本文件构建云端后端发布镜像，运行时通过环境文件和只读挂载提供敏感配置。
FROM golang:1.25-alpine AS builder
LABEL goodhr.project="goodhr" goodhr.build.stage="backend-builder"
ENV GOPROXY=https://goproxy.cn,direct
WORKDIR /src/cloud/backend
COPY cloud/backend/go.mod cloud/backend/go.sum ./
COPY local-agent-go-new/go.mod local-agent-go-new/go.sum /src/local-agent-go-new/
RUN go mod download
COPY cloud/backend/ ./
COPY local-agent-go-new/internal/ /src/local-agent-go-new/internal/
COPY local-agent-go-new/migrations/ /src/local-agent-go-new/migrations/
COPY local-agent-go-new/cloudruntime/ /src/local-agent-go-new/cloudruntime/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /goodhr-server ./cmd/server
LABEL goodhr.build.finished="true"

FROM alpine:3.22
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories \
    && apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /goodhr-server /usr/local/bin/goodhr-server
COPY --from=builder /src/cloud/backend/db ./db
COPY --from=builder /src/cloud/backend/templates ./templates
CMD ["goodhr-server"]
