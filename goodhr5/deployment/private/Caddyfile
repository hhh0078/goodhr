# 本文件为内网 IP 或域名自动签发私有 HTTPS 证书；CA 持久保存，无需公网证书服务。
{
    auto_https disable_redirects
    skip_install_trust
    default_sni {$GOODHR_TLS_SERVER_NAME}
}
{$GOODHR_PUBLIC_BASE_URL} {
    tls internal
    @backend path /api/* /health /uploads/* /downloads/private/* /zip/*
    handle @backend {
        reverse_proxy backend:8084 {
            flush_interval -1
        }
    }
    handle {
        reverse_proxy frontend:3000
    }
}
