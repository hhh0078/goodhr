# 本文件是私有部署配置模板；复制为 private.env 后填写实际地址和密码，不要提交 private.env。
GOODHR_PUBLIC_BASE_URL=https://192.168.1.100:8443
# 必须与上面地址中的端口一致；不写端口时两处都使用443。
GOODHR_HTTPS_PORT=8443
GOODHR_SUPER_ADMINS=admin@example.com
GOODHR_PRIVATE_ADMIN_PASSWORD=请替换为自己的管理员密码
# 数据库密码使用至少24位英文字母和数字，避免 URL 特殊字符。
GOODHR_DB_PASSWORD=ReplaceWithYourOwnRandomPassword2026
GOODHR_PRIVATE_ASSET_SOURCE=https://goodhr.58it.cn
# 平时保持0，首次启动自动下载；维护时联网设为1可重新同步最新版兼容组件，完成后恢复0。
GOODHR_PRIVATE_REFRESH_ASSETS=0
